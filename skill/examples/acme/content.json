    "nav": "My read",
    "title": "Two things I would *protect.*",
    "items": [
      {
        "headline": "The reminder is the product.",
        "theme": "The product",
        "quote": "Reminders people actually keep.",
        "note": "If a nudge arrives at the wrong moment once, it is muted for good. I would make the timing the user's choice from the first screen."
      },
      {
        "headline": "One designer, one thread.",
        "theme": "The role",
        "quote": "first sketch to launch",
        "note": "The same hands should draw the journey, the system and the launch page, so the product sounds like one person wrote it."
      }
    ]
  },
